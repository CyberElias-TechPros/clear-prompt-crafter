<?xml version="1.0" encoding="utf-8"?>
<!--
  The app only talks to HTTPS endpoints. Cleartext is disabled at the platform
  level; the Worker API is HTTPS by default (workers.dev and custom domains).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
