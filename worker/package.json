{
  "name": "prompt-gineer-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for Prompt-Gineer (D1 + KV-less auth + NVIDIA NIM AI gateway)",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/env.d.ts",
    "db:create": "wrangler d1 create prompt-gineer-db",
    "db:init:local": "wrangler d1 execute prompt-gineer-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute prompt-gineer-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^5.5.3",
    "wrangler": "^4.14.4"
  }
}
