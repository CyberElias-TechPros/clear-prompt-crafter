# Leave VITE_API_BASE_URL unset for the explicitly labelled local demo.
# Production: use the deployed Worker API origin plus /api, or a same-origin /api proxy.
VITE_API_BASE_URL=https://prompt-gineer-api.example.workers.dev/api
VITE_SITE_URL=https://your-domain.example

# Optional legacy fallback only when Worker API mode is not configured.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key
