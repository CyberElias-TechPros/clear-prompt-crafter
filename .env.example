# Copy this file to .env and adjust the values.
#
# VITE_API_URL (optional): base URL of the Cloudflare Worker backend.
#   - Leave UNSET to use relative "/api/..." requests (recommended for local dev
#     where Vite proxies /api to the worker on port 8787).
#   - For production, set it to your deployed Worker, e.g.:
#       VITE_API_URL="https://prompt-gineer-api.<your-subdomain>.workers.dev"
#
# VITE_ENABLE_ADS (optional; defaults to false): explicitly enables the app's
# first-party promotional banners. Keep disabled until placements and surrounding
# content have been reviewed against applicable advertising policies. This is not
# an AdMob / Google Mobile Ads integration.
# VITE_ENABLE_ADS=false
