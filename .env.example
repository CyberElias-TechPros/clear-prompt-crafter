# Optional: enable remote auth and persistence. The product runs in demo mode without these values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key

# Production API URL for the Cloudflare Worker (use a relative proxy in Vercel previews)
VITE_API_BASE_URL=/api
VITE_SITE_URL=https://your-domain.example
